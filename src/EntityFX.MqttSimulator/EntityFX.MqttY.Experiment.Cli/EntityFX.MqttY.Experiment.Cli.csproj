<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Same throughput profile as the reference benchmark: the simulator's
         object graph is large and collection pauses otherwise land in ticks. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntityFX.MqttY.LoadBalancing.App\EntityFX.MqttY.LoadBalancing.App.csproj" />
    <ProjectReference Include="..\EntityFX.MqttY.Federation.App\EntityFX.MqttY.Federation.App.csproj" />
    <ProjectReference Include="..\EntityFX.MqttY.MqttRelay.App\EntityFX.MqttY.MqttRelay.App.csproj" />
  </ItemGroup>

</Project>
